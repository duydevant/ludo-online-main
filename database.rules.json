{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('hostId').val() === auth.uid",
        "hostId": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid || !data.parent().child('members').child(data.val()).exists())",
          ".validate": "newData.isString() && (newData.val() === auth.uid || data.val() === auth.uid)"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists()"
        },
        "status": {
          ".write": "auth != null && (root.child('rooms').child($roomId).child('hostId').val() === auth.uid || (!root.child('rooms').child($roomId).child('hostId').exists() && newData.parent().child('hostId').val() === auth.uid))",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || !root.child('rooms').child($roomId).child('kicked').child($uid).exists())) || root.child('rooms').child($roomId).child('hostId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 20"
          }
        },
        "seats": {
          "$color": {
            ".write": "auth != null && ($color === 'red' || $color === 'green' || $color === 'yellow' || $color === 'blue') && (root.child('rooms').child($roomId).child('hostId').val() === auth.uid || (root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && (!data.exists() || data.child('kind').val() === 'bot' || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)))",
            ".validate": "newData.child('kind').val() === 'bot' || (newData.child('kind').val() === 'human' && newData.child('uid').isString() && newData.child('name').isString())"
          }
        },
        "kicked": {
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('hostId').val() === auth.uid"
          }
        },
        "game": {
          ".write": "auth != null && (root.child('rooms').child($roomId).child('hostId').val() === auth.uid || root.child('rooms').child($roomId).child('members').child(auth.uid).exists())",
          ".validate": "!newData.exists() || (newData.child('seq').isNumber() && newData.child('event').isString() && newData.child('state').isString())"
        }
      }
    },
    "chats": {
      "$roomId": {
        ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && !newData.exists() && root.child('rooms').child($roomId).child('hostId').val() === auth.uid",
        "$messageId": {
          ".write": "auth != null && !data.exists() && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && !root.child('rooms').child($roomId).child('kicked').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 'sentAt']) && newData.child('uid').val() === auth.uid && newData.child('name').val() === root.child('rooms').child($roomId).child('members').child(auth.uid).child('name').val() && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 200 && newData.child('sentAt').val() === now",
          "uid": {
            ".validate": true
          },
          "name": {
            ".validate": true
          },
          "text": {
            ".validate": true
          },
          "sentAt": {
            ".validate": true
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
